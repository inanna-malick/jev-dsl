cabal-version:      3.0
name:               jev-dsl
version:            0.1.0.0
synopsis:           Typed record DSL for TypeSafe's Jev: one record renders the request and decodes the response
description:
  Author a question record once. Under the Questions mode it holds wording,
  structured criteria, and local payloads; prepared, it becomes the exact
  request JSON. Under the Answers mode the same record holds typed selections
  with their retained payloads, full distributions, and confidence, decoded
  from the response against the alternatives this request sent. No network:
  any transport carries the JSON.
license:            MIT
license-file:       LICENSE
author:             Inanna Malick
build-type:         Simple
extra-doc-files:    README.md
tested-with:        GHC == 9.12.2

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Werror

library
  import:           shared
  hs-source-dirs:   src
  -- Jev.Core.* import boot packages only (base, containers, text) so they can
  -- be copied verbatim into an environment without aeson and given another
  -- JsonValue instance. Only Jev and Jev.Aeson depend on aeson.
  exposed-modules:
    Jev
    Jev.Aeson
    Jev.Operators
    Jev.Core
    Jev.Core.Json
    Jev.Core.Contract
    Jev.Core.Schema
  build-depends:
    , base        >= 4.18 && < 5
    , containers  >= 0.6
    , text        >= 2.0
    , aeson       ^>= 2.2
    , aeson-pretty >= 0.8
    , scientific  >= 0.3
    , vector      >= 0.13

executable jev-dsl-example
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , aeson
    , bytestring
    , text
    , optparse-applicative >= 0.18
    , jev-dsl

test-suite jev-dsl-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Check
    Proto
    Fixtures
    Shape
    Golden
    Rejections
  build-depends:
    , base
    , containers
    , text
    , aeson
    , bytestring
    , directory
    , filepath
    , vector
    , jev-dsl
