cabal-version:      3.4
name:               jev-dsl
version:            0.1.0.0
synopsis:           Typed question packets for TypeSafe's Jev
description:
  Author a packet of labelled questions once, as an expression whose type is
  inferred. Built, it becomes the exact request JSON. Decoded, the same
  packet holds typed selections with their retained payloads, full
  distributions, and confidence, checked against the alternatives this
  request sent. Alternatives and rubric levels are chains of labels;
  handlers are checked against them at compile time. It covers what a
  program wants to express with Jev, not every request the provider
  accepts. No network: any transport carries the JSON.
license:            MIT
license-file:       LICENSE
author:             Inanna Malick
maintainer:         inanna@recursion.wtf
category:           AI
homepage:           https://github.com/inanna-malick/jev-dsl
bug-reports:        https://github.com/inanna-malick/jev-dsl/issues
build-type:         Simple
extra-doc-files:
  README.md
  CHANGELOG.md
extra-source-files:
  docs/*.md
  examples/*.hs
  scripts/*.sh
  scripts/*.py
  test/reject/*.hs
  test/fixtures/*.json
  test/fixtures/*.md
  test/fixtures/MANIFEST
tested-with:        GHC == 9.12.3

source-repository head
  type:     git
  location: https://github.com/inanna-malick/jev-dsl.git

-- check.sh builds with -Werror; a released package must not, since new GHC
-- warnings would break downstream builds.
flag strict
  description: Treat warnings as errors
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  if flag(strict)
    ghc-options:    -Werror

-- The core is a library of its own so the boundary is the build system's to
-- keep, not a comment's: it cannot reach aeson because it does not depend on
-- it. A program with its own JSON type depends on this and writes a
-- JsonValue instance; it never pays for aeson.
library jev-core
  import:           shared
  visibility:       public
  hs-source-dirs:   core
  exposed-modules:
    Jev.Core
    Jev.Core.Json
    Jev.Core.Contract
    Jev.Core.Schema
  build-depends:
    , base >= 4.21 && < 5
    , text >= 2.0 && < 2.2

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Jev.Operators
    Jev.Aeson
  reexported-modules:
    Jev.Core,
    Jev.Core.Json,
    Jev.Core.Contract,
    Jev.Core.Schema
  build-depends:
    , base >= 4.21 && < 5
    , text >= 2.0 && < 2.2
    , jev-dsl:jev-core
    , aeson       ^>= 2.2
    , scientific  >= 0.3 && < 0.4
    , vector      >= 0.13 && < 0.14

executable jev-dsl-example
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , aeson
    , bytestring >= 0.11 && < 0.13
    , text
    , optparse-applicative >= 0.18 && < 0.20
    , jev-dsl

executable jev-dsl-guard
  import:           shared
  hs-source-dirs:   examples
  main-is:          Guard.hs
  build-depends:
    , base
    , aeson
    , bytestring >= 0.11 && < 0.13
    , process >= 1.6 && < 1.7
    , text
    , jev-dsl

test-suite jev-dsl-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Check
    Corpus
    Proto
    Fixtures
    Replay
    Shape
    Golden
    Rejections
    Mini
    Ergonomics
  build-depends:
    , base
    , text
    , aeson
    , bytestring
    , directory
    , filepath
    , vector
    , jev-dsl
    , jev-dsl:jev-core
