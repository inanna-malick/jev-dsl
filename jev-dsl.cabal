cabal-version:      3.0
name:               jev-dsl
version:            0.1.0.0
synopsis:           Typed packet DSL for TypeSafe's Jev: one packet renders the request and decodes the response
description:
  Author a packet of labelled questions once, as an expression whose type is
  inferred. Built, it becomes the exact request JSON. Decoded, the same
  packet holds typed selections with their retained payloads, full
  distributions, and confidence, checked against the alternatives this
  request sent. Alternatives and rubric levels are chains of labels;
  handlers are checked against them at compile time. It covers what a
  program wants to express with Jev, not every request the provider
  accepts. No network: any transport carries the JSON.
license:            MIT
license-file:       LICENSE
author:             Inanna Malick
maintainer:         inanna@recursion.wtf
category:           AI
homepage:           https://github.com/inanna-malick/jev-dsl
bug-reports:        https://github.com/inanna-malick/jev-dsl/issues
build-type:         Simple
extra-doc-files:    README.md
extra-source-files:
  docs/*.md
  examples/*.hs
  scripts/*
  test/reject/*.hs
  test/fixtures/*.json
  test/fixtures/*.md
  test/fixtures/MANIFEST
tested-with:        GHC == 9.12.2

source-repository head
  type:     git
  location: https://github.com/inanna-malick/jev-dsl.git

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Werror

library
  import:           shared
  hs-source-dirs:   src
  -- Jev.Core.* import boot packages only (base, containers, text) so they can
  -- be copied verbatim into an environment without aeson and given another
  -- JsonValue instance. Only Jev, Jev.Operators, and Jev.Aeson depend on aeson.
  exposed-modules:
    Jev
    Jev.Aeson
    Jev.Operators
    Jev.Core
    Jev.Core.Json
    Jev.Core.Contract
    Jev.Core.Schema
  build-depends:
    , base        >= 4.21 && < 5
    , containers  >= 0.6
    , text        >= 2.0
    , aeson       ^>= 2.2
    , aeson-pretty >= 0.8
    , scientific  >= 0.3
    , vector      >= 0.13

executable jev-dsl-example
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , aeson
    , bytestring
    , text
    , optparse-applicative >= 0.18
    , jev-dsl

executable jev-dsl-guard
  import:           shared
  hs-source-dirs:   examples
  main-is:          Guard.hs
  build-depends:
    , base
    , aeson
    , bytestring
    , process
    , text
    , jev-dsl

test-suite jev-dsl-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Check
    Corpus
    Proto
    Fixtures
    Replay
    Shape
    Golden
    Rejections
  build-depends:
    , base
    , containers
    , text
    , aeson
    , bytestring
    , directory
    , filepath
    , vector
    , jev-dsl
